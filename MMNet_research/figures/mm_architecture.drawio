<mxfile host="app.diagrams.net"><diagram name="MM-Net architecture" id="mmnet"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Two-stream multimodal multi-task network&lt;/b&gt;&lt;br&gt;f&lt;sub&gt;θ&lt;/sub&gt; : (f&lt;sup&gt;eeg&lt;/sup&gt;, z&lt;sup&gt;fnd&lt;/sup&gt;, x&lt;sup&gt;car&lt;/sup&gt;) → (ŷ&lt;sup&gt;stg&lt;/sup&gt;, ŷ&lt;sup&gt;apn&lt;/sup&gt;)   ·   2,764,774 trainable + 5,819,936 frozen" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="620" height="44" as="geometry"/></mxCell><mxCell id="newkey" value="&lt;i&gt;&lt;font color=&quot;#C0392B&quot;&gt;red outline = new since submission&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="260" height="20" as="geometry"/></mxCell><mxCell id="eeg_feat" value="&lt;b&gt;Expert physiology&lt;/b&gt;&lt;br&gt;f&lt;sup&gt;eeg&lt;/sup&gt; ∈ ℝ&lt;sup&gt;188&lt;/sup&gt;&lt;br&gt;band power, spindle, Hjorth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8ECD9;strokeColor=#4E8A52;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="175" height="74" as="geometry"/></mxCell><mxCell id="eeg_fnd" value="&lt;b&gt;Frozen LaBraM&lt;/b&gt;&lt;br&gt;z&lt;sup&gt;fnd&lt;/sup&gt; ∈ ℝ&lt;sup&gt;200&lt;/sup&gt; · 5.82 M frozen&lt;br&gt;4 EEG channels, no gradient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#C0392B;fontSize=12;spacing=4;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="205" y="70" width="175" height="74" as="geometry"/></mxCell><mxCell id="car_feat" value="&lt;b&gt;Raw cardio tensor&lt;/b&gt;&lt;br&gt;x&lt;sup&gt;car&lt;/sup&gt; ∈ ℝ&lt;sup&gt;7×750&lt;/sup&gt; = 5250&lt;br&gt;per-subject z-score, no summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFC9;strokeColor=#C4763A;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="190" height="74" as="geometry"/></mxCell><mxCell id="catE" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="185" y="158" width="30" height="30" as="geometry"/></mxCell><mxCell id="eeg_enc" value="&lt;b&gt;EEG encoder&lt;/b&gt;  φ&lt;sub&gt;eeg&lt;/sub&gt;&lt;br&gt;FeatMLP: 388 → e ∈ ℝ&lt;sup&gt;128&lt;/sup&gt;&lt;br&gt;66,816 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8ECD9;strokeColor=#4E8A52;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="105" y="210" width="190" height="74" as="geometry"/></mxCell><mxCell id="car_enc" value="&lt;b&gt;Cardio encoder&lt;/b&gt;  φ&lt;sub&gt;car&lt;/sub&gt;&lt;br&gt;CardioCNN → c ∈ ℝ&lt;sup&gt;64&lt;/sup&gt;&lt;br&gt;3 conv stages · 155,232 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFC9;strokeColor=#C0392B;fontSize=12;spacing=4;shadow=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="190" height="74" as="geometry"/></mxCell><mxCell id="concatC" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="310" width="30" height="30" as="geometry"/></mxCell><mxCell id="fusion" value="&lt;b&gt;Cross-modal fusion&lt;/b&gt;&lt;br&gt;2 tokens → attention → z ∈ ℝ&lt;sup&gt;128&lt;/sup&gt;&lt;br&gt;99,456 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="175" y="360" width="240" height="74" as="geometry"/></mxCell><mxCell id="bilstm" value="&lt;b&gt;BiLSTM&lt;/b&gt;  (2 layers, bidirectional)&lt;br&gt;context L = 20 epochs · h&lt;sub&gt;t&lt;/sub&gt; ∈ ℝ&lt;sup&gt;512&lt;/sup&gt;&lt;br&gt;2,367,488 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7ECC6;strokeColor=#C2A02F;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="155" y="490" width="280" height="74" as="geometry"/></mxCell><mxCell id="stg_head" value="&lt;b&gt;Staging head&lt;/b&gt;&lt;br&gt;ŷ&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;stg&lt;/sup&gt; = softmax(W&lt;sub&gt;s&lt;/sub&gt; h&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;+ HMM Viterbi decode&lt;br&gt;2,565 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5D9F2;strokeColor=#7A57A8;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="195" height="96" as="geometry"/></mxCell><mxCell id="rsp_head" value="&lt;b&gt;Respiratory head&lt;/b&gt;&lt;br&gt;ŷ&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;apn&lt;/sup&gt; = σ(W&lt;sub&gt;2&lt;/sub&gt;[h&lt;sub&gt;t&lt;/sub&gt; ; c&lt;sub&gt;t&lt;/sub&gt;])&lt;br&gt;direct cardio bypass&lt;br&gt;147,969 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7D8E6;strokeColor=#B0517A;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="335" y="640" width="195" height="96" as="geometry"/></mxCell><mxCell id="e1a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="eeg_feat" target="catE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="eeg_fnd" target="catE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="catE" target="eeg_enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="car_feat