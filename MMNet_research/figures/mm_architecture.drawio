rokeColor=#4E8A52;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="745" y="376" width="160" height="32" as="geometry"/></mxCell><mxCell id="fe_fe1fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe1" target="fe2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_fe2fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe2" target="fe3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_fe3fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe3" target="fe4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_fe4fe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe4" target="fe5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_fe5fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe5" target="fe6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_fe6fe7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="fe6" target="fe7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe_cap" value="&lt;i&gt;EEG branch only: 388 → 128&lt;br&gt;cardio uses CardioCNN (panel C)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="418" width="230" height="32" as="geometry"/></mxCell><mxCell id="cf_panel" value="Cross-modal fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#CACACA;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="340" height="470" as="geometry"/></mxCell><mxCell id="cf_tok" value="tokenize:  T = [W&lt;sub&gt;e&lt;/sub&gt; e ; W&lt;sub&gt;c&lt;/sub&gt; c] + M&lt;sub&gt;type&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="730" y="524" width="280" height="30" as="geometry"/></mxCell><mxCell id="cf_headeq" value="head&lt;sub&gt;i&lt;/sub&gt; = softmax(Q&lt;sub&gt;i&lt;/sub&gt; K&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;⊤&lt;/sup&gt; / √d&lt;sub&gt;k&lt;/sub&gt;) V&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="560" width="280" height="18" as="geometry"/></mxCell><mxCell id="cf_h1" value="head 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="735" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h2" value="head 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="807" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h3" value="head 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="879" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h4" value="head 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="951" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_concat" value="concat heads  ·  W&lt;sub&gt;o&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="765" y="634" width="210" height="30" as="geometry"/></mxCell><mxCell id="cf_add" value="+" style="ellipse;whiteSpa