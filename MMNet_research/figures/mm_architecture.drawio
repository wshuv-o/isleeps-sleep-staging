t;car&lt;/sub&gt;&lt;br&gt;CardioCNN: 7&amp;#215;750 &amp;#8594; c &amp;#8712; &amp;#8477;&lt;sup&gt;64&lt;/sup&gt; · 155,232 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7DFC9;strokeColor=#C4763A;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="428" y="402" width="200" height="76" as="geometry"/></mxCell><mxCell id="car_iso" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="418" y="492" width="340" height="152" as="geometry"/></mxCell><mxCell id="car_iso_cap" value="&lt;i&gt;replaces the 14 engineered cardiorespiratory features&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;" vertex="1" parent="1"><mxGeometry x="418" y="648" width="340" height="14" as="geometry"/></mxCell><mxCell id="concatC" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="786" y="282" width="26" height="26" as="geometry"/></mxCell><mxCell id="fusion" value="&lt;b&gt;Cross-modal fusion&lt;/b&gt;&lt;br&gt;2 tokens &amp;#8594; attention&lt;br&gt;&amp;#8594; z &amp;#8712; &amp;#8477;&lt;sup&gt;128&lt;/sup&gt; · 99,456 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="846" y="256" width="190" height="78" as="geometry"/></mxCell><mxCell id="bilstm" value="&lt;b&gt;BiLSTM&lt;/b&gt; (2 layers, bidirectional)&lt;br&gt;L = 20 epochs (10 min) · 128 &amp;#8594; 2 &amp;#215; 256&lt;br&gt;h&lt;sub&gt;t&lt;/sub&gt; &amp;#8712; &amp;#8477;&lt;sup&gt;512&lt;/sup&gt; · 2,367,488 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7ECC6;strokeColor=#C2A02F;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="1074" y="250" width="220" height="90" as="geometry"/></mxCell><mxCell id="stg_head" value="&lt;b&gt;Staging head&lt;/b&gt;&lt;br&gt;softmax(W&lt;sub&gt;s&lt;/sub&gt; h&lt;sub&gt;t&lt;/sub&gt;) · 512 &amp;#8594; 5&lt;br&gt;+ HMM Viterbi decode · 2,565 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5D9F2;strokeColor=#7A57A8;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="1338" y="154" width="224" height="82" as="geometry"/></mxCell><mxCell id="rsp_head" value="&lt;b&gt;Respiratory head&lt;/b&gt;&lt;br&gt;&amp;#963;(W&lt;sub&gt;2&lt;/sub&gt; GELU(W&lt;sub&gt;1&lt;/sub&gt;[h&lt;sub&gt;t&lt;/sub&gt; ; c&lt;sub&gt;t&lt;/sub&gt;]))&lt;br&gt;576 &amp;#8594; 256 &amp;#8594; 1 · direct cardio bypass&lt;br&gt;147,969 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7D8E6;strokeColor=#B0517A;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="1338" y="344" width="224" height="88" as="geometry"/></mxCell><mxCell id="e1a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="eeg_feat" target="catE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="eeg_fnd" target="catE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="catE" target="eeg_enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="car_feat" target="car_enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eeg_enc" target="concatC"><mxG