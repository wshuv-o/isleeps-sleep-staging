<mxfile host="app.diagrams.net"><diagram name="MM-Net architecture" id="mmnet"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Two-stream multimodal multi-task network&lt;/b&gt;  ·  f&lt;sub&gt;&amp;#952;&lt;/sub&gt; : (f&lt;sup&gt;eeg&lt;/sup&gt;, z&lt;sup&gt;fnd&lt;/sup&gt;, x&lt;sup&gt;car&lt;/sup&gt;) &amp;#8594; (&amp;#375;&lt;sup&gt;stg&lt;/sup&gt;, &amp;#375;&lt;sup&gt;apn&lt;/sup&gt;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="760" height="26" as="geometry"/></mxCell><mxCell id="eeg_img" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="34" y="74" width="128" height="100" as="geometry"/></mxCell><mxCell id="eeg_cap" value="&lt;i&gt;7 ch @ 100 Hz, 30 s&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="178" width="150" height="14" as="geometry"/></mxCell><mxCell id="eeg_feat" value="&lt;b&gt;Expert physiology&lt;/b&gt;&lt;br&gt;f&lt;sup&gt;eeg&lt;/sup&gt; &amp;#8712; &amp;#8477;&lt;sup&gt;188&lt;/sup&gt; · band power,&lt;br&gt;spindle, Hjorth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8ECD9;strokeColor=#4E8A52;fontSize=12;spacing=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="190" y="66" width="172" height="66" as="geometry"/></mxCell><mxCell id="eeg_fnd" value="&lt;b&gt;Frozen LaBraM&lt;/b&gt; &amp;#10052;&lt;br&gt;z&lt;sup&gt;fnd&lt;/sup&gt; &amp;#8712; &amp;#8477;&lt;sup&gt;200&lt;/sup&gt; · 5.82 M frozen&lt;br&gt;4 EEG channels, no gradient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8ECD9;strokeColor=#4E8A52;fontSize=12;spacing=4;shadow=1;dashed=1;