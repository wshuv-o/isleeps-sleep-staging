ive="1" as="geometry"/></mxCell><mxCell id="cf_lf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.0;" edge="1" parent="1" source="cf_ln" target="cf_ff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cf_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9aa2ab;strokeWidth=1.0;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf_tok" target="cf_add"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cf_cap" value="&lt;i&gt;T&amp;#771; = LN(T + concat&lt;sub&gt;i&lt;/sub&gt; head&lt;sub&gt;i&lt;/sub&gt;).  Ablations replace attention with plain concatenation [e ; c] and with a neural-only variant.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;" vertex="1" parent="1"><mxGeometry x="858" y="682" width="706" height="14" as="geometry"/></mxCell><mxCell id="obj" value="Joint objective:  L = CE&lt;sub&gt;&amp;#8730;w&lt;/sub&gt;(&amp;#375;&lt;sup&gt;stg&lt;/sup&gt;, y&lt;sup&gt;stg&lt;/sup&gt;) + &amp;#955; BCE&lt;sub&gt;pw&lt;/sub&gt;(&amp;#375;&lt;sup&gt;apn&lt;/sup&gt;, y&lt;sup&gt;apn&lt;/sup&gt;),  &amp;#955; = 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="560" height="22" as="geometry"/></mxCell><mxCell id="legend" value="&lt;i&gt;dashed outline = frozen (no gradient)  &amp;#183;  2,764,774 trainable + 5,819,936 frozen parameters&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="30" y="714" width="600" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>