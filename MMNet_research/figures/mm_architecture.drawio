" as="geometry"/></mxCell><mxCell id="fe_cap" value="&lt;i&gt;EEG: 188 → 128   ·   Cardio: 14 → 64&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="422" width="230" height="20" as="geometry"/></mxCell><mxCell id="cf_panel" value="Cross-modal fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#CACACA;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="340" height="470" as="geometry"/></mxCell><mxCell id="cf_tok" value="tokenize:  T = [W&lt;sub&gt;e&lt;/sub&gt; e ; W&lt;sub&gt;c&lt;/sub&gt; c] + M&lt;sub&gt;type&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="730" y="524" width="280" height="30" as="geometry"/></mxCell><mxCell id="cf_headeq" value="head&lt;sub&gt;i&lt;/sub&gt; = softmax(Q&lt;sub&gt;i&lt;/sub&gt; K&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;⊤&lt;/sup&gt; / √d&lt;sub&gt;k&lt;/sub&gt;) V&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="560" width="280" height="18" as="geometry"/></mxCell><mxCell id="cf_h1" value="head 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="735" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h2" value="head 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="807" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h3" value="head 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2F5;strokeColor=#3E6FA8;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="879" y="584" width="64" height="30" as="geometry"/></mxCell><mxCell id="cf_h4" value="head 4" style="rounded=1;whit