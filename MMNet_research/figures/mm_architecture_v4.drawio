<mxfile host="app.diagrams.net"><diagram name="MM-Net v4 architecture" id="mmnetv4"><mxGraphModel dx="1500" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageWidth="1260" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="MM-Net v4: dual-prior neural branch, learned cardiorespiratory encoder" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="780" height="30" as="geometry"/></mxCell><mxCell id="t1" value="one 30 s polysomnogram epoch  -&gt;  sleep stage + respiratory event" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666f78;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="780" height="24" as="geometry"/></mxCell><mxCell id="t2" value="red outline = new since submission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#c0392b;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="810" y="48" width="400" height="24" as="geometry"/></mxCell><mxCell id="psg" value="Neural montage&#10;C4:M1  C3:M2  O2:M1  O1:M2  -  E1:M2  E2:M2  -  EMG&#10;7 ch @ 100 Hz - 30 s = 3000 samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#8a9099;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="330" height="74" as="geometry"/></mxCell><mxCell id="cardsig" value="Cardiorespiratory montage&#10;ECG  flow  thorax  abdomen  effort  SpO2  pulse&#10;7 ch @ 25 Hz - 30 s = 750 samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecdd;strokeColor=#c98a52;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="92" width="310" height="74" as="geometry"/></mxCell><mxCell id="t5" value="IMPORTED PRIORS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#4a72b0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="186" width="300" height="18" as="geometry"/></mxCell><mxCell id="t6" value="LEARNED FROM RAW" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#c98a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645" y="186" width="160" height="18" as="geometry"/></mxCell><mxCell id="feat" value="Expert physiology&#10;f_eeg in R^188&#10;112 EEG - 50 EOG - 26 EMG&#10;band power, spindle,&#10;Hjorth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#5a8f66;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="190" height="108" as="geometry"/></mxCell><mxCell id="fnd" value="Frozen LaBraM&#10;z_fnd in R^200&#10;5.82 M frozen params&#10;4 EEG channels only&#10;no gradient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7effb;strokeColor=#c0392b;fontSize=12;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="262" y="220" width="190" height="108" as="geometry"/></mxCell><mxCell id="cardraw" value="Raw cardio tensor&#10;x_car in R^(7 x 750) = 5250&#10;per-subject, per-channel z-score&#10;no hand-designed summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecdd;strokeColor=#c98a52;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="220" width="310" height="108" as="geometry"/></mxCell><mxCell id="cat" value="concat  (+)&#10;388-d  =  188  +  200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#8a9099;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="145" y="366" width="220" height="56" as="geometry"/></mxCell><mxCell id="eegenc" value="EEG encoder  phi_eeg&#10;FeatMLP  388 -&gt; 128&#10;66,816 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#5a8f66;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="135" y="458" width="240" height="86" as="geometry"/></mxCell><mxCell id="cardenc" value="Cardio encoder  phi_car&#10;CardioCNN  5250 -&gt; 64&#10;3 conv stages - 155,232 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecdd;strokeColor=#c0392b;fontSize=12;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="458" width="310" height="86" as="geometry"/></mxCell><mxCell id="fuse" value="Fusion  (concat)&#10;[e ; c] in R^192  -&gt;  z in R^128&#10;24,704 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7effb;strokeColor=#4a72b0;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="576" width="320" height="74" as="geometry"/></mxCell><mxCell id="lstm" value="BiLSTM&#10;2 layers - context L = 20 - h in R^256&#10;-&gt; R^512 - 2,367,488 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6da;strokeColor=#b39a3e;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="684" width="340" height="82" as="geometry"/></mxCell><mxCell id="stage" value="Staging head&#10;softmax(W_s h_t) -&gt; 5 classes&#10;+ HMM Viterbi decode&#10;2,565 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fb;strokeColor=#7a5fa8;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="105" y="808" width="255" height="92" as="geometry"/></mxCell><mxCell id="resp" value="Respiratory head&#10;sigma(W_2 [h_t ; c_t])&#10;direct cardio bypass&#10;147,969 p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7e7;strokeColor=#b8607a;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="808" width="290" height="92" as="geometry"/></mxCell><mxCell id="t17" value="Joint objective:  L = CE_sqrt-w(y_stg) + lambda * BCE_pw(y_apn),  lambda = 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="740" height="22" as="geometry"/></mxCell><mxCell id="t18" value="2,764,774 trainable parameters  (773,254 in the submitted model)  +  5,819,936 frozen" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666f78;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="740" height="22" as="geometry"/></mxCell><mxCell id="t19" value="submitted 0.7275 acc / 0.6536 mF1 / 0.7070 AUC   -&gt;   v4 0.7394 / 0.6701 / 0.7818" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#3a6b43;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="986" width="740" height="22" as="geometry"/></mxCell><mxCell id="p1" value="Feature encoder (FeatMLP)&#10;e = GELU(LN(W2 * GELU(LN(W1 f))))&#10;&#10;Linear -&gt; LayerNorm -&gt; GELU -&gt; Dropout(0.3)&#10;Linear -&gt; LayerNorm -&gt; GELU -&gt; Dropout(0.3)&#10;&#10;EEG branch only:  388 -&gt; 128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#8a9099;fontSize=12;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="92" width="390" height="196" as="geometry"/></mxCell><mxCell id="p2" value="Frozen LaBraM encoder&#10;the imported prior, unchanged by training&#10;&#10;C4:M1 C3:M2 O2:M1 O1:M2 -&gt; C4 C3 O2 O1&#10;   (10-20 names; EOG/EMG have none)&#10;resample 100 -&gt; 200 Hz&#10;split 30 s into 2 x 15 s of 3000 samples&#10;frozen transformer over patch tokens&#10;mean-pool the sub-windows -&gt; R^200&#10;&#10;embeddings cached once, never fine-tuned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7effb;strokeColor=#c0392b;fontSize=12;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="304" width="390" height="272" as="geometry"/></mxCell><mxCell id="p3" value="CardioCNN&#10;kernels sized to respiratory physiology:&#10;events last 10-30 s, so kernels are wide&#10;and the stack downsamples hard -- the&#10;opposite of a spindle detector.&#10;&#10;Conv(7-&gt;48, k=25, s=2)  BN GELU  MaxPool4&#10;Conv(48-&gt;96, k=15)      BN GELU  MaxPool4&#10;Conv(96-&gt;96, k=7)       BN GELU&#10;concat[mean, max] -&gt; Linear -&gt; LN -&gt; GELU&#10;&#10;at 25 Hz a 25-sample kernel is one second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecdd;strokeColor=#c0392b;fontSize=12;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="592" width="390" height="308" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="psg" target="feat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="psg" target="fnd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="feat" target="cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="fnd" target="cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="cat" target="eegenc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="cardsig" target="cardraw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="cardraw" target="cardenc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="eegenc" target="fuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="cardenc" target="fuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="fuse" target="lstm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="lstm" target="stage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="lstm" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="direct c_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c98a52;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="cardenc" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>