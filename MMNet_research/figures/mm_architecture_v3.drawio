<mxfile host="app.diagrams.net"><diagram name="MM-Net v3 architecture" id="mmnetv3"><mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageWidth="1280" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="MM-Net v3: dual-prior multimodal network" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="900" height="30" as="geometry"/></mxCell><mxCell id="t1" value="one 30 s polysomnogram epoch -&gt; sleep stage + respiratory event" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666f78;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="900" height="24" as="geometry"/></mxCell><mxCell id="psg" value="PSG epoch&#10;7 ch @ 100 Hz  ·  30 s = 3000 samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#8a9099;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="300" height="66" as="geometry"/></mxCell><mxCell id="cardsig" value="Cardiorespiratory signals&#10;ECG, flow, thorax, abdomen, SpO2, pulse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecdd;strokeColor=#c98a52;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="92" width="270" height="66" as="geometry"/></mxCell><mxCell id="t4" value="IMPORTED PRIORS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#4a72b0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="130" height="18" as="geometry"/></mxCell><mxCell id="feat" value="Expert physiology&#10;f_eeg in R^188&#10;band power, spindle,&#10;Hjorth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#5a8f66;fontSize=12;align=center;verticalAlign=top;s