ngTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="534" width="300" height="70" as="geometry"/></mxCell><mxCell id="lstm" value="BiLSTM  (optional)&#10;2 layers · context L = 20 · h in R^256&#10;+0.0148 acc when REMOVED, -0.0215 AUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6da;strokeColor=#b39a3e;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="640" width="340" height="74" as="geometry"/></mxCell><mxCell id="stage" value="Staging head&#10;softmax(W_s h_t) -&gt; 5 classes&#10;+ HMM Viterbi decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fb;strokeColor=#7a5fa8;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="762" width="250" height="82" as="geometry"/></mxCell><mxCell id="resp" value="Respiratory head&#10;sigma(W_2 [h_t ; c_t])&#10;direct cardio bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7e7;strokeColor=#b8607a;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="762" width="280" height="82" as="geometry"/></mxCell><mxCell id="t15" value="Joint objective:  L = CE_sqrt-w(y_stg) + lambda · BCE_pw(y_apn),  lambda = 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="872" width="700" height="24" as="geometry"/></mxCell><mxCell id="t16" value="published 0.7275 acc / 0.6536 mF1   -&gt;   v3 0.7485 / 0.6620   (+0.021 acc, p &lt; 0.0001)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#3a6b43;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="700" height="22" as="geometry"/></mxCell><mxCell id="p1" value="Feature encoder (FeatMLP)&#10;e = GELU(LN(W2 · GELU(LN(W1 f))))&#10;&#10;Linear W1  -&gt;  LayerNorm  -&gt;  GELU&#10;Dropout(0.3)&#10;Linear W2  -&gt;  LayerNorm  -&gt;  GELU&#10;&#10;EEG: 388 -&gt; 128    Cardio: 14 -&gt; 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#8a9099;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="92" width="380" height="300" as="geometry"/></mxCell><mxCell id="p2" value="Frozen self-supervised encoder&#10;raw 30 s epoch, 100 Hz&#10;  resample -&gt; 200 Hz&#10;  patch into 1 s tokens&#10;  frozen transformer (4.9-5.8 M p)&#10;  mean-pool over patches&#10;&#10;CBraMod  7 ch -&gt; R^1400&#10;LaBraM   4 ch -&gt; R^200   (10-20 names)&#10;&#10;no gradient; embeddings cached once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7effb;strokeColor=#4a72b0;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="416" width="380" height="320" as="geometry"/></mxCell><mxCell id="p3" value="Why two priors&#10;99 patients is too few to LEARN a&#10;representation, enough to USE one.&#10;&#10;+ SSL vs features alone: +0.0081 acc (p=0.003)&#10;+ SSL vs random init:   +0.0203 acc (p=0.0001)&#10;a third SSL stream adds nothing (n.s.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#5a8f66;fontSize=12;align=center;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="760" width="380" height="162" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="psg" target="feat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="psg" target="fnd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;endAr